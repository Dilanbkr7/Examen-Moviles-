{
  "name": "control-electoral-ionic",
  "private": true,
  "version": "1.0.0",
  "description": "Control electoral para una organización política - Ionic React + Capacitor + Supabase",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
